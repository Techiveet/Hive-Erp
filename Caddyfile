{
    on_demand_tls {
        ask http://backend:8000/api/internal/caddy/allow-domain
    }
}

{$FRONTEND_DOMAIN:hive.techiveet.com} {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /sanctum/* {
        reverse_proxy backend:8000
    }

    handle /storage/* {
        reverse_proxy backend:8000
    }

    handle /tenancy/assets/* {
        reverse_proxy backend:8000
    }

    reverse_proxy frontend:3000
}

{$BACKEND_DOMAIN:hive-backend.techiveet.com} {
    @horizon path /horizon /horizon/*
    redir @horizon https://{$HORIZON_DOMAIN:hive-queue.techiveet.com}{uri} 308

    # Keep WebSocket upgrades working on the API domain for older clients.
    handle_path /app/* {
        reverse_proxy reverb:9000
    }

    handle {
        reverse_proxy backend:8000
    }
}

{$REVERB_DOMAIN:hive-ws.techiveet.com} {
    reverse_proxy reverb:9000
}

{$HORIZON_DOMAIN:hive-queue.techiveet.com} {
    redir / /horizon 308
    reverse_proxy backend:8000
}

{$MEILISEARCH_DOMAIN:hive-search.techiveet.com} {
    reverse_proxy meilisearch:7700
}

https:// {
    tls {
        on_demand
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /sanctum/* {
        reverse_proxy backend:8000
    }

    handle /storage/* {
        reverse_proxy backend:8000
    }

    handle /tenancy/assets/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
