{
    on_demand_tls {
        ask http://backend:8000/api/internal/caddy/allow-domain
    }
}

{$FRONTEND_DOMAIN:hive.techiveet.com} {
    reverse_proxy frontend:3000
}

{$BACKEND_DOMAIN:hive-backend.techiveet.com} {
    # Keep WebSocket upgrades working on the API domain for older clients.
    handle_path /app/* {
        reverse_proxy reverb:9000
    }

    handle {
        reverse_proxy backend:8000
    }
}

{$REVERB_DOMAIN:hive-ws.techiveet.com} {
    reverse_proxy reverb:9000
}

{$HORIZON_DOMAIN:hive-queue.techiveet.com} {
    redir / /horizon 308
    reverse_proxy backend:8000
}

https:// {
    tls {
        on_demand
    }

    reverse_proxy frontend:3000
}
