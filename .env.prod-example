# ==========================================
# HIVE PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. DOMAIN & NETWORK CONFIGURATION
ROOT_DOMAIN=hinohaet.com
SERVER_IP=YOUR_SERVER_PUBLIC_IP_HERE
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8
FRONTEND_DOMAIN=hive.hinohaet.com
BACKEND_DOMAIN=hive-backend.hinohaet.com
REVERB_DOMAIN=hive-ws.hinohaet.com
HORIZON_DOMAIN=hive-queue.hinohaet.com
MEILISEARCH_DOMAIN=hive-search.hinohaet.com
REMBG_DOMAIN=hive-rembg.hinohaet.com
GOTENBERG_DOMAIN=hive-docs.hinohaet.com
REDIS_DOMAIN=hive-redis.hinohaet.com
DB_DOMAIN=hive-db.hinohaet.com
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_INTERNAL_URL=http://frontend:3000
REVERB_INTERNAL_URL=http://reverb:9000
QUEUE_INTERNAL_HOST=queue
DB_INTERNAL_HOST=db
REDIS_INTERNAL_HOST=redis
MEILISEARCH_INTERNAL_URL=http://meilisearch:7700
REMBG_INTERNAL_URL=http://rembg:5000
GOTENBERG_INTERNAL_URL=http://gotenberg:3000

# 2. BASE CONFIGURATION
APP_NAME=Hive
APP_ENV=production
# Generate this using: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://hive-backend.hinohaet.com
FRONTEND_URL=https://hive.hinohaet.com
TENANCY_CENTRAL_DOMAINS=hive.hinohaet.com,hive-backend.hinohaet.com

# 3. DATABASE CONFIGURATION
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hive
DB_USERNAME=hive
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# 4. REDIS & CACHE
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
SESSION_DOMAIN=.hinohaet.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=hive.hinohaet.com,hive-backend.hinohaet.com

# 5. SEARCH (MEILISEARCH)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=YOUR_SECURE_MEILI_MASTER_KEY_HERE

# 5B. CORS
# Add extra patterns here later if you attach tenant domains outside *.hinohaet.com.
CORS_ALLOWED_ORIGINS=https://hive.hinohaet.com
CORS_ALLOWED_ORIGIN_PATTERNS=#^https://([a-zA-Z0-9-]+\.)?hinohaet\.com\z#

# 6. WEBSOCKETS (REVERB)
# Backend config
REVERB_APP_ID=123456
REVERB_APP_KEY=YOUR_SECURE_REVERB_APP_KEY
REVERB_APP_SECRET=YOUR_SECURE_REVERB_APP_SECRET
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=9000
REVERB_HOST=reverb
REVERB_PORT=9000
REVERB_SCHEME=http
# Next.js config (these values are baked into the frontend build)
NEXT_PUBLIC_REVERB_APP_KEY=YOUR_SECURE_REVERB_APP_KEY
NEXT_PUBLIC_REVERB_HOST=hive-ws.hinohaet.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# 7. FRONTEND NEXT.JS CONFIGURATION
NEXT_PUBLIC_API_URL=https://hive-backend.hinohaet.com/api/v1
NEXT_PUBLIC_APP_URL=https://hive.hinohaet.com
NEXT_PUBLIC_CENTRAL_DOMAINS=hive.hinohaet.com,hive-backend.hinohaet.com
NEXT_PUBLIC_ROOT_DOMAIN=hinohaet.com
NEXT_PUBLIC_FRONTEND_DOMAIN=hive.hinohaet.com
NEXT_PUBLIC_BACKEND_DOMAIN=hive-backend.hinohaet.com
NEXT_PUBLIC_REVERB_DOMAIN=hive-ws.hinohaet.com
INTERNAL_API_URL=http://backend:8000/api/v1

# 8. OPTIONAL DASHBOARD URLS
QUEUE_DASHBOARD_URL=https://hive-queue.hinohaet.com/horizon
