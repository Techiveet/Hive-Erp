# ==========================================
# HIVE PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. BASE CONFIGURATION
APP_NAME=Hive
APP_ENV=production
APP_KEY= # Generate this using: php artisan key:generate
APP_DEBUG=false
APP_URL=https://hive-backend.hinohaet.com

# 2. DATABASE CONFIGURATION
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hive
DB_USERNAME=hive
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# 3. REDIS & CACHE
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# 4. SEARCH (MEILISEARCH)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=YOUR_SECURE_MEILI_MASTER_KEY_HERE

# 5. WEBSOCKETS (REVERB)
# Backend config
REVERB_APP_ID=123456
REVERB_APP_KEY=YOUR_SECURE_REVERB_APP_KEY
REVERB_APP_SECRET=YOUR_SECURE_REVERB_APP_SECRET
REVERB_HOST=reverb
REVERB_PORT=9000
REVERB_SCHEME=http
# Next.js config (Passed to frontend container at build time)
NEXT_PUBLIC_REVERB_APP_KEY="${REVERB_APP_KEY}"
NEXT_PUBLIC_REVERB_HOST=hive-backend.hinohaet.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# 6. FRONTEND NEXT.JS CONFIGURATION
NEXT_PUBLIC_API_URL=https://hive-backend.hinohaet.com/api/v1
NEXT_PUBLIC_APP_URL=https://hive.hinohaet.com
INTERNAL_API_URL=http://backend:8000/api/v1
