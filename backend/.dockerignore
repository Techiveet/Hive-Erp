# Ignore vendor dependencies (built inside container)
vendor/
node_modules/

# Ignore storage contents but keep structure
storage/*
!storage/.gitkeep
!storage/app/.gitkeep
!storage/framework/.gitkeep
!storage/logs/.gitkeep

# Specially ignore massive app storage and tenants
public/storage
storage/app/*
storage/tenant*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
storage/debugbar

# Logs and debug
*.log
.phpunit.result.cache
.env
.env.*
!.env.example

# IDE and metadata
.idea
.vscode
.git
.gitignore
*.md
docker-compose*.yml
Dockerfile*
.dockerignore

# Keep essential files
!.gitkeep
